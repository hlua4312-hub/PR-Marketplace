{
  "name": "campus-cart",
  "version": "4.3.0",
  "description": "Mobile-first student marketplace for one campus - buy, sell, give away and swap - with a Supabase backend and an Android WebView shell.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "start:python": "python -m http.server 8080",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"tests/**/*.test.mjs\"",
    "android:debug": "cd android_app && gradlew.bat assembleDebug",
    "android:release": "cd android_app && gradlew.bat assembleRelease"
  },
  "engines": {
    "node": ">=21"
  },
  "keywords": [
    "marketplace",
    "campus",
    "student",
    "barter",
    "peer-to-peer",
    "supabase",
    "pwa",
    "android"
  ]
}
