{
  "name": "pr-marketplace",
  "version": "3.0.0",
  "description": "Mobile-first peer-to-peer marketplace for local community trading in Aizawl, with a Supabase backend and an Android WebView shell.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "npx --yes serve . --listen 8080",
    "start:python": "python -m http.server 8080",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"tests/**/*.test.mjs\"",
    "android:debug": "cd android_app && gradlew.bat assembleDebug",
    "android:release": "cd android_app && gradlew.bat assembleRelease"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "marketplace",
    "peer-to-peer",
    "supabase",
    "pwa",
    "android"
  ]
}
