# Copy this file to keystore.properties and fill in your own values.
# keystore.properties and the .jks itself are gitignored - never commit either.
#
# Create a keystore first:
#   keytool -genkey -v -keystore pr-marketplace-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias pr-marketplace
#
# Then build a signed release with:
#   gradlew assembleRelease

storeFile=pr-marketplace-release.jks
storePassword=CHANGE_ME
keyAlias=pr-marketplace
keyPassword=CHANGE_ME
