# ---- Android build & local machine config ----
android_app/local.properties
android_app/keystore.properties
android_app/**/*.jks
android_app/**/*.keystore
# ...except the Android debug key. It is the same well-known key every SDK
# install generates, with the password "android", so it is not a secret and
# grants no authenticity. It is committed because CI would otherwise mint a
# fresh one per run: a new signature every release, and a phone refusing to
# install the update over the build it already has.
!android_app/debug.keystore
android_app/.gradle/
android_app/.idea/
android_app/build/
android_app/app/build/
android_app/captures/
*.iml

# ---- Build outputs ----
*.apk
*.aab
APK_Outputs/*
!APK_Outputs/.gitkeep

# ---- Node ----
node_modules/
npm-debug.log*

# ---- Local Supabase credentials (see js/config.example.js) ----
js/config.local.js

# ---- OS cruft ----
Thumbs.db
Desktop.ini
.DS_Store

# Generated by the Gradle syncWebAssets task from the web app at the repo root.
# Tracking it would mean a copy that goes stale and shows up dirty after builds.
android_app/app/src/main/assets/www/
